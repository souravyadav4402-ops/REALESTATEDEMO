{
  "name": "parcel-form-india",
  "version": "1.0.0",
  "private": true,
  "description": "Six-page luxury Indian real-estate digital studio platform.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:migration": "node scripts/validate-migration.mjs",
    "check:links": "node scripts/validate-links.mjs",
    "validate": "npm run validate:content && npm run validate:migration && npm run check:links",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.887.0",
    "@aws-sdk/s3-request-presigner": "^3.887.0",
    "@prisma/client": "6.12.0",
    "@sanity/client": "^6.29.1",
    "@sendgrid/mail": "^8.1.5",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.3",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.2",
    "prisma": "6.12.0",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "8.5.28"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
