{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.parcelandform.in/schemas/site.schema.json",
  "title": "Parcel & Form India site configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["brand", "baseUrl", "defaultLocale", "currencies", "navigation", "pages", "openGraph"],
  "properties": {
    "$schema": { "type": "string" },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "shortName", "legalName", "tagline", "email", "phone", "whatsapp", "locations"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string", "minLength": 1 },
        "legalName": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string", "pattern": "^\\+[1-9][0-9 ]+$" },
        "whatsapp": { "type": "string", "format": "uri" },
        "locations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "baseUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "defaultLocale": { "type": "string", "const": "en-IN" },
    "currencies": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "enum": ["INR", "USD", "AED"] } },
    "navigation": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/navigationItem" }
    },
    "pages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["home", "work", "services", "approach", "journal", "contact"],
      "properties": {
        "home": { "$ref": "#/$defs/pageMetadata" },
        "work": { "$ref": "#/$defs/pageMetadata" },
        "services": { "$ref": "#/$defs/pageMetadata" },
        "approach": { "$ref": "#/$defs/pageMetadata" },
        "journal": { "$ref": "#/$defs/pageMetadata" },
        "contact": { "$ref": "#/$defs/pageMetadata" }
      }
    },
    "openGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["siteName", "locale", "image"],
      "properties": {
        "siteName": { "type": "string" },
        "locale": { "type": "string", "const": "en_IN" },
        "image": { "type": "string", "pattern": "^/" }
      }
    }
  },
  "$defs": {
    "navigationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "pattern": "^/" },
        "featured": { "type": "boolean", "default": false }
      }
    },
    "pageMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "title", "description", "openGraph"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "title": { "type": "string", "minLength": 10, "maxLength": 65 },
        "description": { "type": "string", "minLength": 50, "maxLength": 170 },
        "openGraph": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "description", "type"],
          "properties": {
            "title": { "type": "string", "minLength": 10, "maxLength": 95 },
            "description": { "type": "string", "minLength": 20, "maxLength": 200 },
            "type": { "const": "website" }
          }
        }
      }
    }
  }
}
